{
  "info": {
    "name": "Messaging App API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Get JWT Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.access) {",
                  "    pm.environment.set(\"jwt_token\", response.access);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"user@example.com\",\n    \"password\": \"yourpassword\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "http://localhost:8000/api/token/"
          }
        }
      ]
    },
    {
      "name": "Conversations",
      "item": [
        {
          "name": "Create Conversation",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"participant_ids\": [\"PASTE_OTHER_USER_UUID_HERE\"]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "http://localhost:8000/conversations/"
          }
        },
        {
          "name": "List My Conversations",
          "request": {
            "method": "GET",
            "header": [],
            "url": "http://localhost:8000/conversations/"
          }
        }
      ]
    },
    {
      "name": "Messages",
      "item": [
        {
          "name": "Send Message (Nested Route)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"message_body\": \"Hello via nested route!\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "http://localhost:8000/conversations/PASTE_CONVO_UUID_HERE/messages/"
          }
        },
        {
          "name": "List All Messages (Filtered)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8000/messages/?page=1&page_size=10",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["messages", ""],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "page_size", "value": "10" }
              ]
            }
          }
        }
      ]
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{jwt_token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": { "type": "text/javascript", "exec": [""] }
    },
    {
      "listen": "test",
      "script": { "type": "text/javascript", "exec": [""] }
    }
  ]
}