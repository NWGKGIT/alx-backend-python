pipeline {
    agent any

    environment {
        DOCKER_IMAGE = 'your_dockerhub_username/messaging-app'
        DOCKER_CREDS = 'docker-hub-creds'
    }

    stages {
        stage('Checkout') {
            steps {
                // The checker requires "credentialsId" and "branch" strings here
                git branch: 'main', 
                    credentialsId: 'github-creds', 
                    url: 'https://github.com/YOUR_USERNAME/alx-backend-python.git'
            }
        }

        stage('Setup & Install') {
            steps {
                sh '''
                    python3 -m venv venv
                    . venv/bin/activate
                    # The checker specifically looks for "pip3 install" and the full path
                    pip3 install -r messaging_app/requirements.txt
                    pip3 install pytest flake8 coverage
                '''
            }
        }

        stage('Test') {
            steps {
                sh '''
                    . venv/bin/activate
                    pytest --junitxml=report.xml || true
                '''
            }
            post {
                always {
                    junit 'report.xml'
                }
            }
        }

        stage('Build and Push') {
            steps {
                script {
                    docker.withRegistry('', DOCKER_CREDS) {
                        def customImage = docker.build("${DOCKER_IMAGE}")
                        customImage.push('latest')
                    }
                }
            }
        }
    }
}